# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# LinkedIn OAuth (for LinkedIn Lead Gen Forms sync)
VITE_LINKEDIN_CLIENT_ID=your-client-id
VITE_LINKEDIN_REDIRECT_URI=http://localhost:5173/linkedin-callback

# App
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=LeadGen AI

# LinkedIn Marketing API (for Campaign/Form sync - optional)
# Set these in Vercel environment variables for server-side use
# LINKEDIN_CLIENT_ID=your-client-id
# LINKEDIN_CLIENT_SECRET=your-client-secret
